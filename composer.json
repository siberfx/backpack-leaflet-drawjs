{
    "name": "siberfx/backpack-leaflet-drawjs",
    "description": "Leaflet Draw polygon field (GeoJSON) for Laravel Backpack 7.x",
    "keywords": [
        "laravel",
        "laravel 12",
        "laravel 13",
        "backpack",
        "backpack 7",
        "backpack field",
        "leaflet",
        "leaflet-draw",
        "leaflet-polygon",
        "geojson",
        "openstreetmap",
        "mapbox"
    ],
    "homepage": "https://github.com/siberfx/backpack-leaflet-drawjs",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "role": "Fullstack Software Engineer"
        }
    ],
    "require": {
        "php": "^8.2",
        "backpack/crud": "^7.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\LeafletDrawjs\\LeafletDrawServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\LeafletDrawjs\\": "src"
        }
    }
}
